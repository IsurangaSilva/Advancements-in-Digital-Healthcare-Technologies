// scheduler.js
const cron = require('node-cron');
const axios = require('axios');
const dotenv = require('dotenv').config();

// Function to make the API call
const triggerWeightedAverage = async () => {
  try {
    const baseUrl = process.env.BASE_URL || 'http://localhost:4000';
    const response = await axios.get(`${baseUrl}/api/average/5min-weighted-average`);
    console.log('Scheduled task executed successfully:', response.data);
  } catch (error) {
    console.error('Error in scheduled task:', error.message);
  }
};

// Function to make the API call
const triggerWeightedAverage60min = async () => {
  try {
    const baseUrl = process.env.BASE_URL || 'http://localhost:4000';
    const response = await axios.get(`${baseUrl}/api/average/60min-weighted-average`);
    console.log('Scheduled task executed successfully:', response.data);
  } catch (error) {
    console.error('Error in scheduled task:', error.message);
  }
};

// Schedule the task to run every 5 minutes
const startScheduler = () => {

  cron.schedule('*/1 * * * *', () => {
    console.log('Running 5-minute weighted average task...');
    triggerWeightedAverage();
  });

  cron.schedule('*/5 * * * *', () => {
    console.log('Running 60-minute weighted average task...');
    triggerWeightedAverage60min();
  });
};

module.exports = { startScheduler };